# Copy to .env for LOCAL testing only. In GitHub Actions these are set via
# repo Settings > Secrets and variables > Actions, NOT via a committed .env file.

# GitHub token with `repo` (or fine-grained "Pull requests: read & write") scope.
# In Actions this is auto-provided as secrets.GITHUB_TOKEN — you don't need to
# set this yourself for the workflow to run.
GITHUB_TOKEN=

# Anthropic API key — must be added as a repo secret named ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
CLAUDE_MODEL=claude-sonnet-5
RULES_PATH=rules/coding_rules.md
FALLBACK_USER_STORY_PATH=docs/user_story_example.md
FALLBACK_TECH_DESIGN_PATH=docs/technical_design_example.md
MAX_DIFF_CHARS=60000
